# FOCO now uses Supabase for the API and database.
# The publishable key is public and is configured in src/services/api.ts.
# Never place Gemini or Supabase secret keys in frontend code.

# Add this under Supabase Dashboard -> Edge Functions -> Secrets:
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Optional server-only secret used by the account-deletion route.
# The Supabase hosted environment may already expose SUPABASE_SECRET_KEYS.
# Never publish this value or commit a real key.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SECRET_KEY"
