# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Generate a unique random secret (at least 32 characters) for each deployment.
# Example command: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# STORAGE: on Render, attach a Persistent Disk mounted at /var/data.
# FOCO will then store its JSON database in /var/data/foco automatically.
# You can override this path explicitly with FOCO_DATA_DIR.
# FOCO_DATA_DIR="/var/data/foco"

# SUPABASE CONFIGURATION (not connected to the current backend storage):
# These values alone do not enable persistence or migrate existing app data.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

